# Copy to server/.env and fill in. This file is read only by the server; never put these values into the app.

# development | production
ADIS_ENV=development

# Default: SQLite file server/data/adis.db. Production: PostgreSQL (schema is migrated automatically on start).
# Local portable PostgreSQL (tools\pg.ps1):
# ADIS_DATABASE_URL=postgresql://adis:adis-local-dev@127.0.0.1:5433/adis

# Comma-separated origins allowed to call the API ("*" = any; tokens are sent in headers, not cookies)
ADIS_CORS_ORIGINS=*

# Token lifetimes, seconds
ADIS_ACCESS_TTL=3600
ADIS_REFRESH_TTL=2592000

# "Demo for presentation" button: creates an isolated pre-filled account per login. Turn off for public production.
ADIS_DEMO_LOGIN=true

# Serve the PWA (../app) from the same origin as the API
ADIS_SERVE_APP=true

# ---- Language model (any OpenAI-compatible Chat Completions API with tool calling) ----
# Leave ADIS_LLM_BASE_URL / ADIS_LLM_MODEL empty to use the built-in rule-based engine.
# OpenAI:      https://api.openai.com/v1                 model e.g. gpt-5.4-mini (+ ADIS_LLM_REASONING=none)
# DeepSeek:    https://api.deepseek.com/v1               model e.g. deepseek-chat
# OpenRouter:  https://openrouter.ai/api/v1              model e.g. anthropic/claude-3.5-sonnet
# Anthropic:   https://api.anthropic.com/v1              (OpenAI SDK compatibility endpoint)
# Ollama:      http://localhost:11434/v1                 model e.g. qwen2.5:7b (no key)
ADIS_LLM_BASE_URL=
ADIS_LLM_API_KEY=
ADIS_LLM_MODEL=
ADIS_LLM_TIMEOUT=60
# true only if the model accepts images
ADIS_LLM_VISION=false
# how many previous messages of the conversation are sent to the model
ADIS_LLM_HISTORY=20
# Optional. GPT-5.x: leave temperature empty and set ADIS_LLM_REASONING=none (function tools in Chat Completions require it)
ADIS_LLM_TEMPERATURE=
ADIS_LLM_REASONING=

# ---- Push notifications (Web Push / VAPID) ----
# Empty = keys are generated once into server/data/vapid.json. In production set them explicitly and never change them
# (changing the key silently breaks every existing subscription). Private key: PEM with \n instead of newlines.
ADIS_VAPID_PUBLIC_KEY=
ADIS_VAPID_PRIVATE_KEY=
ADIS_VAPID_SUBJECT=mailto:admin@adis.app

# Delivery worker (reminders, event reminders, alarms) inside the API process; seconds between checks.
# With several API replicas keep it on in one of them (on PostgreSQL rows are locked, so duplicates are impossible anyway).
ADIS_WORKER=true
ADIS_WORKER_INTERVAL=15

# Public https URL of this server, used in calendar subscription links (empty = taken from the request)
ADIS_PUBLIC_URL=
# ---- Cloud voice (speech-to-text + text-to-speech) ----
# auto = on when the LLM provider is OpenAI (same key). true/false to force. Separate provider: ADIS_VOICE_BASE_URL / ADIS_VOICE_API_KEY.
ADIS_VOICE=auto
ADIS_STT_MODEL=gpt-4o-mini-transcribe
ADIS_TTS_MODEL=gpt-4o-mini-tts
# coral, nova, shimmer, sage, alloy, ash, ballad, echo, fable, onyx, verse (users can pick their own in Profile -> Voice)
ADIS_TTS_VOICE=coral
